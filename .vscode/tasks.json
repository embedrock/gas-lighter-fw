{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Flash Signed App (J-Link)",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"${command:cmake.buildDirectory}",
				"--target",
				"flash_app"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"detail": "Собирает и прошивает через J-Link (использует кэш CMake Tools)",
			"problemMatcher": []
		},
		{
			"label": "Flash F4 (j-link)",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/C",
				"((echo r & echo h & echo loadfile stm32f4-debug/${workspaceFolderBasename}.elf & echo q) > flash.jlink) && (JLink.exe -device STM32F407VG -if SWD -speed 4000 -NoGui 1 -CommandFile flash.jlink)"
			],
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"detail": "Flash STM32F4 (j-link).",
			"problemMatcher": []
		},
		{
			"label": "Erase F4 (j-link)",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/C",
				"((echo r & echo h & echo erase & echo q) > erase.jlink) && (JLink.exe -device STM32F407VG -if SWD -speed 4000 -NoGui 1 -CommandFile erase.jlink)"
			],
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"detail": "Erase STM32F4 (j-link)."
		},
		{
			"label": "Flash F7 (j-link)",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/C",
				"((echo r & echo h & echo loadfile stm32f7-debug/${workspaceFolderBasename}.elf & echo q) > flash.jlink) && (JLink.exe -device STM32F746IG -if SWD -speed 4000 -NoGui 1 -CommandFile flash.jlink)"
			],
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"detail": "Flash STM32F7 (j-link).",
			"problemMatcher": []
		},
		{
			"label": "Flash DFU (select slot)",
			"type": "shell",
			"command": "./tools/win64/dfu-util.exe",
			"args": [
				"-a",
				"${input:dfu_slot}",
				"-t",
				"1024",
				"-D",
				"build/stm32f4-debug/gas-lighter-fw_signed.bin"
			],
			"problemMatcher": [],
			"detail": "Flash via USB DFU"
		},
		{
			"label": "DFU: List Devices",
			"type": "shell",
			"command": "./tools/win64/dfu-util.exe",
			"args": [
				"-l"
			],
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true,
				"showReuseMessage": false
			},
			"detail": "Show list DFU-devices"
		},
		{
			"label": "Run qemu-arm (gdb)",
			"type": "shell",
			"command": "qemu-system-arm",
			"args": [
				"-M",
				"netduinoplus2",
				"-nographic",
				"-serial",
				"mon:stdio",
				"-gdb",
				"tcp::1234",
				"-S",
				//"-kernel", "${command:cmake.launchTargetPath}"
				"-device", "loader,file=${command:cmake.launchTargetPath},cpu-num=0"
			],
			"isBackground": true,
			"problemMatcher": {
				"pattern": [
					{
						"regexp": ".",
						"file": 1,
						"location": 2,
						"message": 3
					}
				],
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^.*",
					"endsPattern": "^$"
				}
			}
		},
		{
			"label": "Run qemu-arm",
			"type": "shell",
			"command": "qemu-system-arm",
			"args": [
				"-M",
				"netduinoplus2",
				"-nographic",
				"-serial", "mon:stdio",
				//"-kernel", "${command:cmake.launchTargetPath}"
				"-device", "loader,file=${command:cmake.launchTargetPath},cpu-num=0"
			],
			"isBackground": true,
			"problemMatcher": {
				"pattern": [
					{
						"regexp": ".",
						"file": 1,
						"location": 2,
						"message": 3
					}
				],
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^.*",
					"endsPattern": "^$"
				}
			}
		}
	],
	"inputs": [
		{
			"id": "dfu_slot",
			"description": "choose slot",
			"type": "pickString",
			"options": [
				{
					"label": "0 - Primary Slot (direct write without update)",
					"value": "0"
				},
				{
					"label": "1 - Secondary Slot (for OTA-update by means of MCUboot)",
					"value": "1"
				}
			],
			"default": "1"
		}
	]
}